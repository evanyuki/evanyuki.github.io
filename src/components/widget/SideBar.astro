---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Hitokoto from "./Hitokoto.astro";
import CherryQrTree from "../CherryQrTree.astro";

interface Props {
  class?: string;
  headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---

<div id="sidebar" class:list={[className, "w-full"]}>
  <div class="flex flex-col w-full gap-4 mb-4">
    <Profile />
    <CherryQrTree />
  </div>
  <div
    id="sidebar-sticky"
    class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky"
  >
    <Hitokoto class="onload-animation" style="animation-delay: 100ms" />
    <Categories class="onload-animation" style="animation-delay: 150ms" />
  </div>
</div>
