---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));

const minDepth = headings.reduce(
	(depth, heading) => Math.min(depth, heading.depth),
	Infinity,
);
const maxDepth = minDepth + siteConfig.toc.depth;
const tocHeadings = headings.filter((heading) => heading.depth < maxDepth);

const removeTrailingHash = (text: string) =>
	text.endsWith("#") ? text.slice(0, -1) : text;
---

{isPostsRoute && tocHeadings.length > 0 &&
	<table-of-contents class:list={[className, "toc-shell group/toc"]}>
		<div class="toc-list-wrap">
			<ul class="toc-list" aria-label="文章目录">
				<span
					data-toc-rail
					aria-hidden="true"
					class="toc-rail"
					style="opacity: 0"
				></span>
				{tocHeadings.map((heading, index) => (
					<li
						data-toc-item
						data-anchor-id={heading.slug}
						class="toc-item"
						style={`--toc-ripple-delay: ${index * 50}ms`}
					>
						<a
							href={`#${heading.slug}`}
							data-toc-entry
							data-depth={heading.depth}
							data-index={index}
							title={removeTrailingHash(heading.text)}
							style={`--toc-indent: ${14 + (heading.depth - minDepth) * 8.4}px`}
							class="toc-entry text-50"
						>
							<span>{removeTrailingHash(heading.text)}</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<div class="toc-wave" aria-hidden="true">
			<svg
				viewBox="0 0 28 10"
				fill="none"
				preserveAspectRatio="none"
			>
				<path
					d="M2 7 C4 2, 7 2, 9 5.5 C11 9, 14 9, 16 5 C18 1, 21 2, 24 6"
					stroke="currentColor"
					stroke-linecap="round"
					stroke-width="1.2"
					vector-effect="non-scaling-stroke"
				></path>
			</svg>
		</div>

		<div class="toc-reading text-50">
			<div class="toc-progress-row">
				<span class="toc-reading-icon toc-progress-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<path d="M12 22q-2.05 0-3.875-.788t-3.187-2.15q-1.363-1.362-2.15-3.187T2 12q0-2.075.788-3.887t2.15-3.175Q6.3 3.575 8.124 2.788T12 2q.425 0 .713.288T13 3q0 .425-.288.713T12 4Q8.675 4 6.337 6.338T4 12q0 3.325 2.338 5.663T12 20q3.325 0 5.663-2.337T20 12q0-.425.288-.712T21 11q.425 0 .713.288T22 12q0 2.05-.788 3.875t-2.15 3.188q-1.362 1.362-3.175 2.15T12 22"></path>
					</svg>
				</span>
				<span data-toc-progress>0%</span>
			</div>
		</div>
	</table-of-contents>}

<style>
	.toc-shell {
		display: block;
		position: relative;
		font-family: "Instrument Sans", MiSans, Roboto, system-ui, -apple-system,
			"PingFang SC", "Microsoft YaHei", sans-serif;
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: 0.01em;
		line-height: 1.5rem;
	}

	.toc-list-wrap {
		min-height: 0;
		padding-inline: 7px;
	}

	.toc-list {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
		scroll-behavior: smooth;
	}

	.toc-item {
		position: relative;
		height: 24.5px;
		margin: 0;
		padding: 0;
		line-height: 0.875rem;
	}

	.toc-entry {
		display: inline-block;
		position: relative;
		min-width: 0;
		max-width: 100%;
		height: 21px;
		margin: 0 0 1.5px;
		padding: 0 0 0 var(--toc-indent);
		overflow: hidden;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		font-weight: 400;
		line-height: 21px;
		text-align: left;
		text-overflow: ellipsis;
		white-space: nowrap;
		opacity: 0.35;
		transition:
			opacity 300ms ease-in-out,
			color 300ms ease-in-out;
	}

	.toc-entry:hover,
	.toc-entry:focus-visible {
		opacity: 0.8;
	}

	.toc-entry:focus-visible {
		outline: none;
	}

	.toc-entry.is-current {
		color: var(--primary);
		font-weight: 500;
		opacity: 1;
	}

	.toc-rail {
		position: absolute;
		z-index: 1;
		left: 0;
		top: 0;
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(
			to bottom,
			var(--primary) 0%,
			var(--primary) 80%,
			transparent 100%
		);
		box-shadow:
			0 0 6px color-mix(in srgb, var(--primary) 35%, transparent),
			1px 0 12px color-mix(in srgb, var(--primary) 12%, transparent);
		pointer-events: none;
		transition:
			top 400ms cubic-bezier(0.4, 0, 0.2, 1),
			height 400ms cubic-bezier(0.4, 0, 0.2, 1),
			opacity 200ms ease;
	}

	.toc-wave {
		position: relative;
		height: 2rem;
		transition: opacity 300ms ease;
	}

	.toc-wave svg {
		display: block;
		position: absolute;
		top: 50%;
		width: 150px;
		max-width: 100%;
		height: 10px;
		color: rgb(0 0 0 / 12%);
		transform: translateY(-50%);
	}

	:global(.dark) .toc-wave svg {
		color: rgb(255 255 255 / 12%);
	}

	.toc-reading {
		width: fit-content;
		padding-inline: 7px;
	}

	.toc-progress-row {
		display: flex;
		position: relative;
		width: 100%;
		min-height: 21px;
		align-items: center;
		padding-left: 1rem;
		font-size: 0.875rem;
		line-height: 21px;
		white-space: nowrap;
	}

	.toc-reading-icon {
		display: flex;
		position: absolute;
		left: 0;
		top: 50%;
		width: 1rem;
		height: 1rem;
		align-items: center;
		justify-content: flex-start;
		transform: translate(-0.5rem, -50%);
	}

	.toc-reading-icon svg {
		display: block;
		width: 1rem;
		height: 1rem;
	}

	.toc-progress-icon {
		color: var(--primary);
	}

	.toc-progress-icon path {
		fill: currentColor;
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-entry,
		.toc-rail,
		.toc-wave {
			transition: none;
		}
	}
</style>

<script>
	type TocItem = {
		entry: HTMLAnchorElement;
		heading: HTMLElement;
		section: HTMLElement;
		depth: number;
	};

	type VisibleRange = {
		first: number;
		last: number;
	};

	class TableOfContents extends HTMLElement {
		items: TocItem[] = [];
		rail: HTMLElement | null = null;
		progress: HTMLElement | null = null;
		tocScroller: HTMLElement | null = null;
		resizeObserver: ResizeObserver | null = null;
		animationFrame = 0;
		skipAutoScrollUntil = 0;

		connectedCallback() {
			requestAnimationFrame(() => this.init());
		}

		disconnectedCallback() {
			this.destroy();
		}

		init() {
			this.destroy();
			this.rail = this.querySelector<HTMLElement>("[data-toc-rail]");
			this.progress = this.querySelector<HTMLElement>("[data-toc-progress]");
			this.tocScroller = document.getElementById("toc-inner-wrapper");

			this.items = Array.from(
				this.querySelectorAll<HTMLAnchorElement>("[data-toc-entry]"),
			).flatMap((entry) => {
				const id = decodeURIComponent(entry.hash.slice(1));
				const heading = document.getElementById(id);
				const depth = Number(entry.dataset.depth);

				if (!(heading instanceof HTMLElement) || Number.isNaN(depth)) {
					return [];
				}

				const section = heading.closest("section") ?? heading.parentElement ?? heading;
				return [{ entry, heading, section, depth }];
			});

			if (!this.items.length || !this.rail) return;

			window.addEventListener("scroll", this.scheduleUpdate, { passive: true });
			window.addEventListener("resize", this.scheduleUpdate, { passive: true });
			window.addEventListener("hashchange", this.scheduleUpdate);
			this.addEventListener("click", this.handleClick);

			this.resizeObserver = new ResizeObserver(this.scheduleUpdate);
			this.resizeObserver.observe(this);
			this.resizeObserver.observe(document.documentElement);
			this.scheduleUpdate();
		}

		destroy() {
			cancelAnimationFrame(this.animationFrame);
			window.removeEventListener("scroll", this.scheduleUpdate);
			window.removeEventListener("resize", this.scheduleUpdate);
			window.removeEventListener("hashchange", this.scheduleUpdate);
			this.removeEventListener("click", this.handleClick);
			this.resizeObserver?.disconnect();
			this.resizeObserver = null;
			this.tocScroller = null;
		}

		handleClick = (event: Event) => {
			const anchor = event
				.composedPath()
				.find((element) => element instanceof HTMLAnchorElement);

			if (anchor) {
				this.skipAutoScrollUntil = performance.now() + 700;
				window.setTimeout(this.scheduleUpdate, 0);
			}
		};

		scheduleUpdate = () => {
			cancelAnimationFrame(this.animationFrame);
			this.animationFrame = requestAnimationFrame(this.update);
		};

		getVisibleRange(): VisibleRange {
			const visible: number[] = [];
			const viewportTop = 0;
			const viewportBottom = window.innerHeight;

			this.items.forEach((item, index) => {
				const bounds = item.section.getBoundingClientRect();
				if (bounds.bottom > viewportTop && bounds.top < viewportBottom) {
					visible.push(index);
				}
			});

			if (visible.length > 0) {
				return { first: visible[0], last: visible[visible.length - 1] };
			}

			const readingLine = Math.min(window.innerHeight * 0.32, 180);
			let current = 0;
			for (let index = 0; index < this.items.length; index++) {
				if (this.items[index].heading.getBoundingClientRect().top <= readingLine) {
					current = index;
				} else {
					break;
				}
			}

			return { first: current, last: current };
		}

		updateRail(range: VisibleRange) {
			if (!this.rail) return;

			this.items.forEach((item, index) => {
				const isCurrent = index === range.first;
				item.entry.classList.toggle("is-current", isCurrent);
				if (isCurrent) item.entry.setAttribute("aria-current", "location");
				else item.entry.removeAttribute("aria-current");
			});

			const firstItem = this.items[range.first].entry.parentElement;
			const lastItem = this.items[range.last].entry.parentElement;
			if (!(firstItem instanceof HTMLElement) || !(lastItem instanceof HTMLElement)) {
				this.rail.style.opacity = "0";
				return;
			}

			const list = firstItem.parentElement;
			if (!(list instanceof HTMLElement)) return;
			const listBounds = list.getBoundingClientRect();
			const firstBounds = firstItem.getBoundingClientRect();
			const lastBounds = lastItem.getBoundingClientRect();
			const top = firstBounds.top - listBounds.top + list.scrollTop;
			const height = lastBounds.bottom - firstBounds.top;
			this.rail.style.top = `${top}px`;
			this.rail.style.height = `${height}px`;
			this.rail.style.opacity = "1";
		}

		updateProgress() {
			const article = document.querySelector<HTMLElement>(".prose");
			const articleTop = article
				? article.getBoundingClientRect().top + window.scrollY
				: 0;
			const articleBottom = article
				? articleTop + article.scrollHeight
				: document.documentElement.scrollHeight;
			const start = Math.max(0, articleTop - window.innerHeight * 0.2);
			const end = Math.max(start + 1, articleBottom - window.innerHeight * 0.55);
			const ratio = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
			const percentage = Math.round(ratio * 100);

			if (this.progress) this.progress.textContent = `${percentage}%`;
		}

		scrollRangeIntoView(range: VisibleRange) {
			if (
				!this.tocScroller ||
				performance.now() < this.skipAutoScrollUntil
			) {
				return;
			}

			const first = this.items[range.first].entry;
			const last = this.items[range.last].entry;
			const scrollerBounds = this.tocScroller.getBoundingClientRect();
			const firstBounds = first.getBoundingClientRect();
			const lastBounds = last.getBoundingClientRect();
			const padding = 32;

			if (
				firstBounds.top >= scrollerBounds.top + padding &&
				lastBounds.bottom <= scrollerBounds.bottom - padding
			) {
				return;
			}

			this.tocScroller.scrollTo({
				top:
					this.tocScroller.scrollTop +
					firstBounds.top -
					scrollerBounds.top -
					padding,
				behavior: "smooth",
			});
		}

		update = () => {
			if (!this.items.length || !this.rail) return;
			const range = this.getVisibleRange();
			this.updateRail(range);
			this.updateProgress();
			this.scrollRangeIntoView(range);
		};
	}

	if (!customElements.get("table-of-contents")) {
		customElements.define("table-of-contents", TableOfContents);
	}
</script>
