---
import { Icon } from "astro-icon/components";
import FriendLinkCard from "@/components/FriendLinkCard.astro";
import { commentConfig } from "@/config";
import { manualFriendLinks } from "@/data/friend-links";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="友情链接"
	description="与独立博客和有趣创作者相遇的友情链接页面。"
>
	<section
		id="friend-links"
		class="space-y-5"
		data-manual-links={JSON.stringify(manualFriendLinks)}
		data-comment-server={commentConfig.serverURL}
		data-comment-path="/links/"
	>
		<div class="card-base relative isolate overflow-hidden rounded-[var(--radius-large)] p-6 md:p-7">
			<div class="absolute -right-8 -top-10 -z-10 h-40 w-40 rounded-full bg-[var(--primary)] opacity-[0.07] blur-2xl"></div>
			<div class="absolute right-24 top-7 -z-10 h-14 w-14 rounded-2xl border border-[var(--primary)] opacity-10 rotate-12"></div>
			<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
				<div>
					<div class="mb-3 flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-[var(--primary)]">
						<Icon name="material-symbols:hub-outline" class="text-base" />
						FRIENDS ON THE WEB
					</div>
					<h1 class="text-3xl font-bold md:text-4xl">友情链接</h1>
					<p class="mt-3 max-w-2xl leading-7 text-50">
						在各自的数字角落里书写、思考与创造。欢迎来交换链接，让这张小小的网络持续生长。
					</p>
				</div>
				<a href="#friend-link-comment" class="group inline-flex items-center gap-2 rounded-xl bg-[var(--primary)] px-3.5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:brightness-110">
						<Icon name="material-symbols:add-link-rounded" class="text-lg" />
						申请友链
						<Icon name="fa6-solid:arrow-right" class="text-xs transition group-hover:translate-x-0.5" />
					</a>
			</div>
		</div>

		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3" data-friend-links-grid>
			{
				manualFriendLinks.map((friend) => (
					<FriendLinkCard friend={friend} source="manual" />
				))
			}
			<a href="#friend-link-comment" class="group flex h-28 items-center gap-3 rounded-[var(--radius-large)] border border-dashed border-[var(--primary)]/40 bg-[var(--btn-regular-bg)] p-4 transition hover:border-[var(--primary)] hover:bg-[var(--btn-regular-bg-hover)]">
				<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--card-bg)] text-[var(--primary)] shadow-sm transition group-hover:scale-105">
					<Icon name="material-symbols:person-add-rounded" class="text-2xl" />
				</span>
				<span class="min-w-0">
					<span class="block font-bold text-90">期待下一位朋友</span>
					<span class="mt-1 block truncate text-sm text-50">按模板留言，即可出现在这里</span>
				</span>
				<Icon name="fa6-solid:arrow-right" class="ml-auto text-xs text-[var(--primary)] transition group-hover:translate-x-0.5" />
			</a>
		</div>

		<section class="grid gap-3 lg:grid-cols-[1fr_1.15fr]">
			<div class="card-base rounded-[var(--radius-large)] p-6">
				<h2 class="text-xl font-bold">申请友链</h2>
				<p class="mt-3 leading-7 text-50">
					请在下方评论区留下完整信息。格式正确的公开评论会自动显示在本页；站长也会手动维护友链。
				</p>
				<ul class="mt-4 space-y-2.5 text-sm leading-6 text-50">
					<li>请先在你的网站添加本站友链。</li>
					<li>链接与头像请使用可公开访问的 HTTP 或 HTTPS 地址。</li>
					<li>评论将以最新一条有效申请为准；重复网址只展示一次。</li>
				</ul>
			</div>

			<div class="card-base rounded-[var(--radius-large)] p-6">
				<h2 class="text-xl font-bold">评论模板</h2>
				<p class="mt-3 text-sm leading-6 text-50">
					请逐行填写下列字段；字段名不区分大小写。
				</p>
				<pre class="mt-4 overflow-x-auto rounded-xl bg-[var(--codeblock-bg)] p-4 text-sm leading-7 text-white"><code>name: Evanyuki
link: https://blog.evanyuki.com
desc: 自分の生活に忠実である
avatar: https://reurl.cc/XxGL1D</code></pre>
			</div>
		</section>

		<section id="friend-link-comment" class="card-base rounded-[var(--radius-large)] p-6">
			<div class="mb-5 flex items-center justify-between gap-4">
				<h2 class="text-xl font-bold">留言申请</h2>
				<span class="rounded-full bg-[var(--btn-regular-bg)] px-3 py-1 text-xs text-50">按模板填写即可自动同步</span>
			</div>
			<div id="waline"></div>
		</section>
	</section>
</MainGridLayout>
