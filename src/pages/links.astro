---
import { Icon } from "astro-icon/components";
import FriendLinkCard from "@/components/FriendLinkCard.astro";
import { commentConfig } from "@/config";
import { manualFriendLinks } from "@/data/friend-links";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="友情链接"
	description="与独立博客和有趣创作者相遇的友情链接页面。"
>
	<section
		id="friend-links"
		class="space-y-5"
		data-manual-links={JSON.stringify(manualFriendLinks)}
		data-comment-server={commentConfig.serverURL}
		data-comment-path="/links/"
	>
		<div class="card-base relative isolate overflow-hidden rounded-[var(--radius-large)] p-6 md:p-7">
			<div class="absolute -right-8 -top-10 -z-10 h-40 w-40 rounded-full bg-[var(--primary)] opacity-[0.07] blur-2xl"></div>
			<div class="absolute right-24 top-7 -z-10 h-14 w-14 rotate-12 rounded-2xl border border-[var(--primary)] opacity-10"></div>
			<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
				<div>
					<div class="mb-3 flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-[var(--primary)]">
						<Icon name="material-symbols:hub-outline" class="text-base" />
						FRIENDS ON THE WEB
					</div>
					<h1 class="text-3xl font-bold md:text-4xl">友情链接</h1>
					<p class="mt-3 max-w-2xl leading-7 text-50">
						在各自的数字角落里书写、思考与创造。欢迎来交换链接，让这张小小的网络持续生长。
					</p>
				</div>
				<button type="button" class="group inline-flex items-center gap-2 rounded-xl bg-[var(--primary)] px-3.5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:brightness-110" data-friend-link-application-open>
					<Icon name="material-symbols:add-link-rounded" class="text-lg" />
					申请友链
					<Icon name="fa6-solid:arrow-right" class="text-xs transition group-hover:translate-x-0.5" />
				</button>
			</div>
		</div>

		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3" data-friend-links-grid>
			{
				manualFriendLinks.map((friend) => (
					<FriendLinkCard friend={friend} source="manual" />
				))
			}
			<button type="button" class="group flex h-28 items-center gap-3 rounded-[var(--radius-large)] border border-dashed border-[var(--primary)]/40 bg-[var(--btn-regular-bg)] p-4 text-left transition hover:border-[var(--primary)] hover:bg-[var(--btn-regular-bg-hover)]" data-friend-link-application-open>
				<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--card-bg)] text-[var(--primary)] shadow-sm transition group-hover:scale-105">
					<Icon name="material-symbols:person-add-rounded" class="text-2xl" />
				</span>
				<span class="min-w-0">
					<span class="block font-bold text-90">期待下一位朋友</span>
					<span class="mt-1 block truncate text-sm text-50">提交申请后会自动出现在这里</span>
				</span>
				<Icon name="fa6-solid:arrow-right" class="ml-auto text-xs text-[var(--primary)] transition group-hover:translate-x-0.5" />
			</button>
		</div>

		<section class="grid gap-3 lg:grid-cols-[1fr_1.15fr]">
			<div class="card-base rounded-[var(--radius-large)] p-6">
				<h2 class="text-xl font-bold">申请友链</h2>
				<p class="mt-3 leading-7 text-50">
					可使用下方留言模板，或点击“申请友链”填写表单。格式正确的公开评论会自动显示在本页；站长也可手动维护友链。
				</p>
				<ul class="mt-4 space-y-2.5 text-sm leading-6 text-50">
					<li>请先在你的网站添加本站友链。</li>
					<li>链接与头像请使用可公开访问的 HTTP 或 HTTPS 地址。</li>
					<li>评论将以最新一条有效申请为准；重复网址只展示一次。</li>
				</ul>
			</div>

			<div class="card-base rounded-[var(--radius-large)] p-6">
				<h2 class="text-xl font-bold">评论模板</h2>
				<p class="mt-3 text-sm leading-6 text-50">
					请逐行填写下列字段；字段名不区分大小写。
				</p>
				<pre class="mt-4 overflow-x-auto rounded-xl bg-[var(--codeblock-bg)] p-4 text-sm leading-7 text-white"><code>name: Evanyuki
link: https://blog.evanyuki.com
desc: 自分の生活に忠実である
avatar: https://reurl.cc/XxGL1D</code></pre>
			</div>
		</section>

		<section id="friend-link-comment" class="card-base rounded-[var(--radius-large)] p-6">
			<div class="mb-5 flex items-center justify-between gap-4">
				<h2 class="text-xl font-bold">留言申请</h2>
				<span class="rounded-full bg-[var(--btn-regular-bg)] px-3 py-1 text-xs text-50">按模板填写即可自动同步</span>
			</div>
			<div id="waline"></div>
		</section>

		<dialog class="m-auto w-[min(92vw,900px)] rounded-[var(--radius-large)] bg-[var(--card-bg)] p-0 text-[var(--text-normal)] shadow-2xl backdrop:bg-black/60" data-friend-link-application-dialog>
			<div class="max-h-[88vh] overflow-y-auto p-6 md:p-7">
				<div class="mb-6 flex items-start justify-between gap-4">
					<div><h2 class="text-2xl font-bold">友链申请</h2><p class="mt-2 text-sm leading-6 text-50">提交后会自动展示在本页。</p></div>
					<button type="button" class="rounded-lg p-2 text-50 transition hover:bg-[var(--btn-regular-bg)] hover:text-90" aria-label="关闭友链申请" data-friend-link-application-close><Icon name="material-symbols:close-rounded" class="text-xl" /></button>
				</div>

				<form class="space-y-5" data-friend-link-application-form>
					<div class="flex flex-wrap items-center gap-3"><span class="text-sm font-medium text-50">申请类型：</span><button type="button" class="rounded-xl border border-[var(--primary)] bg-[var(--primary)] px-4 py-2 text-sm font-bold text-white transition" data-friend-link-application-kind="new" aria-pressed="true">新增申请</button><button type="button" class="rounded-xl border border-[var(--line-divider)] px-4 py-2 text-sm font-bold text-50 transition hover:border-[var(--primary)] hover:text-[var(--primary)]" data-friend-link-application-kind="update" aria-pressed="false">修改信息</button><input type="hidden" name="applicationType" value="new" data-friend-link-application-type /></div>

					<div class="grid gap-4 md:grid-cols-2">
						<label class="space-y-2"><span class="text-sm font-medium text-90">网站名称</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="name" maxlength="80" required placeholder="网站名称" /></label>
						<label class="space-y-2"><span class="text-sm font-medium text-90">网站链接</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="link" type="url" required placeholder="https://example.com" /></label>
						<label class="space-y-2"><span class="text-sm font-medium text-90">Logo 链接</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="avatar" type="url" required placeholder="https://example.com/avatar.png" /></label>
						<label class="space-y-2"><span class="text-sm font-medium text-90">网站简介</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="description" maxlength="240" required placeholder="一句话介绍你的网站" /></label>
						<label class="space-y-2"><span class="text-sm font-medium text-90">网站截图（可选）</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="screenshot" type="url" placeholder="https://example.com/screenshot.png" /></label>
						<label class="space-y-2"><span class="text-sm font-medium text-90">联系邮箱</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="email" type="email" required placeholder="you@example.com" /></label>
					</div>

					<label class="block space-y-2"><span class="text-sm font-medium text-90">RSS 地址（可选）</span><input class="w-full rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-3 outline-none transition focus:border-[var(--primary)]" name="rss" type="url" placeholder="https://example.com/rss.xml" /><span class="block text-sm text-50">如 RSS 不在常见路径，请填写完整 RSS / Atom 地址；留空时会由站长确认。</span></label>
					<label class="flex items-start gap-3 rounded-xl bg-[var(--btn-regular-bg)] p-4 text-sm leading-6 text-50"><input class="mt-1 size-4 accent-[var(--primary)]" type="checkbox" name="requirements" required /><span>我已添加本站友链；申请主体为个人博客；网站可正常访问，内容符合法律法规，并同意站长为展示一致性调整昵称或头像。</span></label>
					<div class="flex flex-wrap items-center gap-4"><button class="inline-flex items-center gap-2 rounded-xl bg-[var(--primary)] px-5 py-3 font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60" type="submit" data-friend-link-application-submit><Icon name="material-symbols:send-rounded" class="text-lg" />提交申请</button><p class="text-sm text-50" aria-live="polite" data-friend-link-application-status>联系邮箱仅用于审核与回复，不会在友链卡片中公开。</p></div>
				</form>
			</div>
		</dialog>
	</section>
</MainGridLayout>
